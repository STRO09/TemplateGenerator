            }
          ],
          "integrations": [
            {
              "file": "src/routes/index.routes.js",
              "operation": "add-import",
              "source": "./order.routes.js",
              "specifiers": [
                {
                  "kind": "default",
                  "local": "orderRouter"
                }
              ]
            },
            {
              "file": "src/routes/index.routes.js",
              "operation": "insert-before-call",
              "callee": "router.use",
              "statements": [
                "router.use(\"/orders\", orderRouter);"
              ]
            },
            {
              "file": "src/config/env.js",
              "operation": "add-object-properties",
              "object": "env",
              "properties": [
                {
                  "key": "PAYMENT_PROVIDER",
                  "value": "process.env.PAYMENT_PROVIDER"
                },
                {
                  "key": "RAZORPAY_KEY_ID",
                  "value": "paymentProvider === \"razorpay\" ? required(\"RAZORPAY_KEY_ID\") : process.env.RAZORPAY_KEY_ID"
                },
                {
                  "key": "RAZORPAY_KEY_SECRET",
                  "value": "paymentProvider === \"razorpay\" ? required(\"RAZORPAY_KEY_SECRET\") : process.env.RAZORPAY_KEY_SECRET"
                }
              ]
            },
            {
              "file": ".env.example",
              "operation": "merge-env",
              "entries": {
                "PAYMENT_PROVIDER": "razorpay",
                "RAZORPAY_KEY_ID": "YOUR_RAZORPAY_KEY_ID",
                "RAZORPAY_KEY_SECRET": "YOUR_RAZORPAY_KEY_SECRET"
              }
            }
          ]
        },
